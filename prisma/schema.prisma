generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  plan            String   @default("free") // "free" | "pro"
  billingInterval String? // "monthly" | "yearly" — cosmetic until real billing lands
  createdAt       DateTime @default(now())

  memberships Membership[]
  invites     Invite[]
  forms       Form[]
  apiKeys     ApiKey[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("owner") // "owner" | "member"
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("member")
  token       String    @unique
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  keyPrefix   String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
}

model Form {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  slug           String   @unique
  description    String?
  fields         String // JSON-encoded array of FormField
  gdprText       String   @default("By submitting this form, you agree to let us store and process the information above to respond to your request.")
  ctaText        String   @default("Submit")
  successMessage String   @default("Thanks! Your submission was received.")
  redirectUrl    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions Submission[]
}

model Submission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      String // JSON-encoded key/value answers
  sourceIp  String?
  userAgent String?
  createdAt DateTime @default(now())
}
